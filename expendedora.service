[Unit]
Description=Maquina Expendedora - Sistema Principal
After=multi-user.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/Desktop/proyecto
ExecStart=/usr/bin/python3 /home/admin/Desktop/proyecto/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
